# ─────────────────────────────────────────────────────────────
# Basis-URL der Website (für OG-Bilder, canonical-Links, sitemap)
# ─────────────────────────────────────────────────────────────
#
# Wird von app/lib/site.ts ausgewertet. Reihenfolge:
#   1. NEXT_PUBLIC_SITE_URL              (diese Variable – gewinnt immer)
#   2. VERCEL_PROJECT_PRODUCTION_URL     (automatisch von Vercel gesetzt)
#   3. VERCEL_URL                        (aktuelle Deployment-/Preview-URL)
#   4. Fallback: https://www.sapcoding.de
#
# Sobald die Domain sapcoding.de mit Vercel verbunden ist, hier bzw.
# in den Vercel Project Settings (Environment Variables) eintragen:
#
#   NEXT_PUBLIC_SITE_URL=https://www.sapcoding.de
#
# Dann zeigen alle OG-/canonical-/sitemap-URLs eindeutig auf die
# finale Domain – wichtig für sauberes SEO.

NEXT_PUBLIC_SITE_URL=https://www.sapcoding.de
